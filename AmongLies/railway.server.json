{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npx turbo run build --filter=@amonglies/server...",
    "watchPatterns": ["apps/server/**", "packages/shared/**", "package-lock.json"]
  },
  "deploy": {
    "startCommand": "node apps/server/dist/main",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
