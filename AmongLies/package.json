{
  "name": "amonglies",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "dev:web": "turbo dev --filter=@amonglies/web",
    "dev:server": "turbo dev --filter=@amonglies/server",
    "dev:all": "turbo dev --parallel",
    "test": "npm test --workspace @amonglies/server",
    "check-secrets": "sh scripts/check-secrets.sh",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=20.9"
  }
}
