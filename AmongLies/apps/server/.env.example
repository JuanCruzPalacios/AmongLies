# URL del frontend (CORS). En desarrollo: http://localhost:3000
# En producción (Render): https://amonglies-web.onrender.com
CLIENT_URL=http://localhost:3000

# Puerto del servidor. Render lo setea automáticamente.
PORT=3001

# Supabase (proyecto AmongLies). La URL es pública.
SUPABASE_URL=https://pyamkqingktpeexkgryb.supabase.co
# Clave secreta del servidor (Dashboard → Project Settings → API Keys → Secret keys).
# Nunca se commitea ni se usa en el frontend.
# Sin estas dos variables el servidor funciona igual para invitados (sin cuentas ni estadísticas).
SUPABASE_SECRET_KEY=
